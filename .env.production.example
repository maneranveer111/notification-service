# Production environment configuration for Notification Service
# Run: python scripts/generate_env.py --production --domain notify.example.com

# ------------------------------------------
# Environment & Deployment Mode
# ------------------------------------------
# Enforces strict secret validation and production security rules
ENVIRONMENT=production

# ------------------------------------------
# Domain & TLS (Caddy reverse proxy)
# ------------------------------------------
# Fully qualified public domain name (e.g., notify.example.com or localhost for local testing)
DOMAIN=notify.example.com
# Email address for automatic Let's Encrypt / ZeroSSL TLS certificate issuance
ACME_EMAIL=admin@example.com

# ------------------------------------------
# Docker Image Configuration
# ------------------------------------------
# Container image registry namespace
IMAGE_REGISTRY=ghcr.io/OWNER
# Container image tag to pull or build
IMAGE_TAG=latest

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
# Database name for the application
POSTGRES_DB=notification_db
# Database admin user
POSTGRES_USER=postgres
# Database password (generate with scripts/generate_env.py)
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# ------------------------------------------
# Redis Authentication
# ------------------------------------------
# Redis server password for authentication
REDIS_PASSWORD=replace_with_secure_redis_password

# ------------------------------------------
# Security & Secret Keys
# ------------------------------------------
# JWT signing secret (minimum 32 characters)
JWT_SECRET=replace_with_secure_jwt_secret_min_32_chars
# Fernet encryption key(s) for per-workspace credentials (comma-separated for key rotation)
ENCRYPTION_KEY=replace_with_valid_fernet_key
# Master header-based API key (minimum 24 characters)
API_KEY=replace_with_secure_master_api_key_min_24_chars
# HMAC secret for outgoing webhook signatures
WEBHOOK_SECRET=replace_with_secure_webhook_secret
# HMAC secret for one-click unsubscribe links
UNSUBSCRIBE_SECRET=replace_with_secure_unsubscribe_secret
# Bearer token protecting Prometheus metrics endpoint
METRICS_TOKEN=replace_with_secure_metrics_token

# ------------------------------------------
# Accounts & Registration
# ------------------------------------------
# Registration mode: invite_only is recommended in production
SIGNUP_MODE=invite_only
# Require email verification before new users can log in
REQUIRE_EMAIL_VERIFICATION=true
# System mail backend for verification and invite emails: must be 'provider' in production
SYSTEM_MAIL_BACKEND=provider

# ------------------------------------------
# Platform Email Provider (required for account & system emails)
# ------------------------------------------
# Provider fallback preference: brevo,smtp or smtp,brevo
EMAIL_PROVIDER_ORDER=brevo,smtp
# SMTP server hostname
SMTP_HOST=smtp.example.com
# SMTP authentication username
SMTP_USER=smtp-username
# SMTP authentication password
SMTP_PASSWORD=smtp-password
# Default system sender email address
SMTP_FROM_EMAIL=notifications@example.com
# SMTP port (typically 587 for STARTTLS or 465 for SSL)
SMTP_PORT=587
# Enable STARTTLS for SMTP connections
SMTP_USE_TLS=true
# Brevo API key for transactional emails
BREVO_API_KEY=xkeysib-replace_with_brevo_api_key
# Sender email verified in Brevo
BREVO_FROM_EMAIL=notifications@example.com
# Sender display name in Brevo
BREVO_FROM_NAME=Notification Service

# ------------------------------------------
# Platform SMS Provider (optional)
# ------------------------------------------
# Twilio Account SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio Auth Token
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
# Twilio sender phone number in E.164 format
TWILIO_FROM_NUMBER=+1234567890

# ------------------------------------------
# Application URLs & Routing
# ------------------------------------------
# Public API base URL used for webhook callbacks
PUBLIC_BASE_URL=https://${DOMAIN}/api
# Allowed CORS origins for frontend requests
FRONTEND_URL=https://${DOMAIN}
# Public frontend URL used in email invitation links
FRONTEND_PUBLIC_URL=https://${DOMAIN}
# Subpath root path for the backend API behind the reverse proxy
ROOT_PATH=/api

# ------------------------------------------
# Proxy & Logging
# ------------------------------------------
# Traffic passes through two proxies (Caddy then nginx), so TRUSTED_PROXY_COUNT must be 2
TRUSTED_PROXY_COUNT=2
# Log format: json is recommended for production container log collectors
LOG_FORMAT=json

# ------------------------------------------
# Quotas & Bot Protection
# ------------------------------------------
# Enable workspace rate limits and monthly dispatch quotas
QUOTA_ENABLED=true
# Cloudflare Turnstile public site key (leave blank to disable CAPTCHA)
TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key (leave blank to disable CAPTCHA)
TURNSTILE_SECRET_KEY=
