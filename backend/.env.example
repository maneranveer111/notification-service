# Database
DATABASE_URL=postgresql://postgres:yourpass@localhost:5432/notification_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Brevo (transactional email)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=you@yourdomain.com

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Header-based API key  (NOTE: no space after the = sign)
API_KEY=your-api-key

# App settings
APP_NAME=Notification Service
DEBUG=False

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173