# ==========================================
# Notification Service — Root Environment Configuration
# Copy this file to .env and fill in the required values.
# Run: python scripts/generate_env.py  to auto-generate secrets.
# ==========================================

# ------------------------------------------
# Docker Compose service variables
# ------------------------------------------
POSTGRES_DB=notification_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ------------------------------------------
# Frontend build (Vite) and nginx runtime
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# ------------------------------------------
# Worker
# ------------------------------------------
ENABLE_BEAT=false

# ------------------------------------------
# Application Settings
# ------------------------------------------
APP_NAME=Notification Service
ENVIRONMENT=development
DEBUG=False
LOG_FORMAT=text

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DATABASE_URL=postgresql://postgres:yourpass@localhost:5432/notification_db

# Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------
# Redis & Celery
# REDIS_URL is used for both Celery broker and backend.
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_QUEUE=notification_service_queue

# ------------------------------------------
# Public Base URL and Webhooks
# ------------------------------------------
PUBLIC_BASE_URL=http://localhost:8001
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_VERIFY=True

# ------------------------------------------
# Master Header-based API Key
# ------------------------------------------
API_KEY=your-api-key

# ------------------------------------------
# JWT Dashboard Authentication
# ------------------------------------------
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars
JWT_EXPIRE_MINUTES=480

# ------------------------------------------
# Prometheus Metrics Token
# ------------------------------------------
METRICS_TOKEN=replace_with_a_metrics_token

# ------------------------------------------
# Frontend URL (CORS allowed origins)
# ------------------------------------------
FRONTEND_URL=http://localhost:5173,http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:5173

# ------------------------------------------
# Limits and Scheduling
# ------------------------------------------
SCHEDULE_MAX_DAYS=30
BULK_MAX_RECIPIENTS=200
MAX_WORKSPACES_PER_USER=5

# ------------------------------------------
# Accounts & Self-Service
# ------------------------------------------
SIGNUP_MODE=open
REQUIRE_EMAIL_VERIFICATION=True
SYSTEM_MAIL_BACKEND=provider

# ------------------------------------------
# Unsubscribe and Suppression
# ------------------------------------------
UNSUBSCRIBE_SECRET=replace_with_a_secure_secret

# ------------------------------------------
# Webhook Channel Allowed Hosts (comma-separated)
# ------------------------------------------
WEBHOOK_CHANNEL_ALLOWED_HOSTS=hooks.slack.com,discord.com,discordapp.com

# ------------------------------------------
# Email Provider Order and SMTP
# ------------------------------------------
EMAIL_PROVIDER_ORDER=brevo,smtp
SMTP_HOST=smtp.example.com
SMTP_USER=smtp-username
SMTP_PASSWORD=smtp-password
SMTP_FROM_EMAIL=notifications@yourdomain.com
SMTP_PORT=587
SMTP_USE_TLS=True

# ------------------------------------------
# Brevo (Transactional Email)
# ------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=you@yourdomain.com

# ------------------------------------------
# Twilio (SMS)
# ------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ------------------------------------------
# Hardening & Per-Workspace Providers
# ------------------------------------------
# One or more Fernet keys, comma-separated; first encrypts, all decrypt (for key rotation).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ALLOW_PRIVATE_SMTP_HOSTS=False
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_STORAGE_URI=

# ------------------------------------------
# Plans, Quotas & CAPTCHA
# ------------------------------------------
QUOTA_ENABLED=True
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
